NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never expose a Supabase secret/service role key to the browser.
RECOVRA_AI_PROVIDER=
RECOVRA_AI_API_KEY=
RECOVRA_ENCRYPTION_KEY=

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# Cixy's AI (console.anthropic.com → API keys). Server only.
ANTHROPIC_API_KEY=
# Transactional email (resend.com). Needed for support/sign-in emails.
RESEND_API_KEY=
# Supabase service_role key. Server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Shown on legal pages, e.g. `Texas`.
NEXT_PUBLIC_GOVERNING_LAW=
# Shown on legal pages.
NEXT_PUBLIC_LEGAL_ADDRESS=
# Shown on legal pages.
NEXT_PUBLIC_LEGAL_EMAIL=
# Shown on legal pages.
NEXT_PUBLIC_LEGAL_ENTITY=
# Optional second AI provider. Only used when ANTHROPIC_API_KEY is missing.
OPENAI_API_KEY=
# Optional model override for extraction.
RECOVRA_AI_MODEL=
# Set `true` only to force demo data. Leave unset in production.
RECOVRA_FORCE_DEMO=
# Optional Cixy model override. Default claude-sonnet-5 (claude-3-5-sonnet was retired 2025-10-28).
ANTHROPIC_MODEL=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=
